# OPNsense WireGuard + DynDNS helper (copy to config.env and fill in)
# Used by the Proxmox LXC helper and Linux scripts under helper/

# OPNsense management (LAN)
OPNSENSE_URL=https://192.168.0.1
OPNSENSE_API_KEY=PASTE_API_KEY
OPNSENSE_API_SECRET=PASTE_API_SECRET
OPNSENSE_INSECURE=1

# Dynamic DNS
VPN_HOSTNAME=vpn.example.com
DNS_ZONE=example.com
# cloudflare | namecheap | duckdns | godaddy | or exact OPNsense service label via DYNDNS_SERVICE
DYNDNS_PROVIDER=cloudflare
DYNDNS_SERVICE=
DYNDNS_USERNAME=token
DYNDNS_PASSWORD=PASTE_DNS_TOKEN
DYNDNS_CHECKIP=if
DYNDNS_INTERFACE=wan
DYNDNS_INTERVAL=300

# WireGuard
WG_INSTANCE_NAME=home
WG_TUNNEL_CIDR=10.10.10.1/24
WG_LISTEN_PORT=51820
WG_LAN_CIDR=192.168.0.0/22
WG_DNS=192.168.0.1

# Optional: WireGuard interface name on OPNsense after assignment (e.g. opt1)
WG_INTERFACE=
